    {
      "id": "image-surface-reload-after-double-load",
      "jar": "jars/ImageSurfaceReloadSuite.jar",
      "width": 240,
      "height": 320,
      "description": "Regression: Image.createImage after double load_state should not white-screen",
      "stable": true,
      "tags": [
        "save-load"
      ],
      "steps": [
        {
          "action": "wait",
          "ms": 1000
        },
        {
          "action": "save"
        },
        {
          "action": "wait",
          "ms": 1500
        },
        {
          "action": "load"
        },
        {
          "action": "keyPress",
          "key": "5"
        },
        {
          "action": "wait",
          "ms": 300
        }
      ]
    },
