{
  "name": "@jsjvm/visual-snapshot-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "jar:build": "node ../jar-builder/build-jars-from-sources.js --src-dir cases/src --resources-dir cases/res --output-dir cases/jars",
    "capture": "npm run jar:build && npm run build && node dist/capture.js",
    "compare": "npm run build && node dist/compare.js",
    "update:baseline": "npm run build && node dist/compare.js --update-baseline",
    "update:reference": "npm run build && node dist/update-reference.js",
    "test": "npm run jar:build && npm run build && node dist/test.js webgpu",
    "dev": "npm run jar:build && npm run build && node dist/viewer.js"
  },
  "dependencies": {
    "j2me-web": "workspace:*",
    "@rsbuild/core": "1.6.14",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.56.1",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pngjs": "^6.0.5",
    "typescript": "^7.0.2"
  }
}
