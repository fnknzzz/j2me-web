# J2ME 开发环境配置示例
# 复制此文件为 .env.local 并填入你的实际路径

# Java 8 JDK 安装目录
# Mac 示例: JAVA_HOME=/Library/Java/JavaVirtualMachines/temurin-8.jdk/Contents/Home
# Windows 示例: JAVA_HOME=C:\Program Files (x86)\Java\jdk1.8.0_331
JAVA_HOME=

# WTK (Wireless Toolkit) 安装目录 (仅 Windows WTK 构建需要)
# Windows 示例: WTK_HOME=C:\WTK2.5.2
WTK_HOME=

# Mac 端提交请求时使用：Windows 机器在局域网内的 IP
# wtk-submit.js 会请求 http://WINDOWS_IP:8787/run
# 示例: WINDOWS_IP=192.168.1.100
WINDOWS_IP=
