// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`MediaPlayerSuite > should test Media Player API and match snapshot 1`] = `
"[print] println("=== Media Player Test ===")
[print] println("Test 1: Manager basics")
[media] getSupportedContentTypes("capture") => []
[print] print("Supported content types count: ")
[print] println("0")
[media] getSupportedProtocols("audio/midi") => []
[print] print("Supported protocols count: ")
[print] println("0")
[print] println("Test 2: Create player from resource")
[media] createPlayer({"locator":"/sound.mid"})
[print] println("Player created from resource")
[print] print("Initial state: ")
[print] println("100")
[print] print("Content type: ")
[print] println("audio/midi")
[media] close()
[print] print("State after close: ")
[print] println("0")
[print] println("Test 3: Create player from stream")
[media] createPlayer({"data":{"0":109,"1":117,"2":115,"3":105,"4":99,"5":32,"6":109,"7":105,"8":100,"9":105,"10":32,"11":99,"12":111,"13":110,"14":116,"15":101,"16":110,"17":116,"18":10},"contentType":"audio/midi"})
[print] println("Player created from stream")
[print] print("State: ")
[print] println("100")
[print] println("Player listener added")
[media] close()
[print] println("Test 4: Player states")
[media] createPlayer({"locator":"/tone.mid"})
[print] print("State UNREALIZED: ")
[print] println("true")
[print] print("State REALIZED: ")
[print] println("true")
[print] print("State PREFETCHED: ")
[print] println("true")
[media] play()
[print] print("State STARTED: ")
[print] println("true")
[print] print("Duration: ")
[print] println("1000000")
[print] print("Media time: ")
[print] println("0")
[media] stop()
[print] print("State after stop: ")
[print] println("300")
[media] stop()
[print] println("Player deallocated")
[media] close()
[print] print("State CLOSED: ")
[print] println("true")
[print] println("Test 5: ToneControl")
[media] createPlayer({"locator":"device://tone"})
[print] println("ToneControl obtained")
[print] println("Tone sequence set")
[media] close()
[print] println("Test 6: VolumeControl")
[media] createPlayer({"locator":"/audio.wav"})
[print] println("VolumeControl obtained")
[print] print("Current volume level: ")
[print] println("100")
[media] setVolume(75)
[print] print("New volume level: ")
[print] println("75")
[print] print("Is muted: ")
[print] println("false")
[media] setMuted(true)
[print] print("Muted: ")
[print] println("true")
[media] setMuted(false)
[print] print("Unmuted: ")
[print] println("false")
[media] close()
[print] println("Test 7: Play tone")
[media] playTone(60, 500, 100)
[print] println("Tone played: note 60, duration 500ms, volume 100")
[media] playTone(64, 300, 80)
[print] println("Tone played: note 64, duration 300ms, volume 80")
[media] playTone(67, 400, 90)
[print] println("Tone played: note 67, duration 400ms, volume 90")
[print] println("Media player test completed")"
`;
